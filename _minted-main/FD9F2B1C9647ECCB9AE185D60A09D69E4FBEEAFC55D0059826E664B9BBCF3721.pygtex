\begin{Verbatim}[commandchars=\\\{\}]
\PYG{k}{if} \PYG{n+nv+vm}{\PYGZus{}\PYGZus{}name\PYGZus{}\PYGZus{}} \PYG{o}{==} \PYG{l+s+s2}{\PYGZdq{}\PYGZus{}\PYGZus{}main\PYGZus{}\PYGZus{}\PYGZdq{}}\PYG{p}{:}
    \PYG{c+c1}{\PYGZsh{} Crear la configuración de la simulación usando variables globales.}
    \PYG{n}{config} \PYG{o}{=} \PYG{n}{SimulationConfig}\PYG{p}{()}
    \PYG{n}{sim\PYGZus{}runner} \PYG{o}{=} \PYG{n}{SimulationRunner}\PYG{p}{(}\PYG{n}{config}\PYG{p}{)}

    \PYG{c+c1}{\PYGZsh{} Lista de funciones objetivo (buscando estabilidad, sin target específico)}
    \PYG{n}{objectives} \PYG{o}{=} \PYG{p}{[}
        \PYG{n}{objective\PYGZus{}variation\PYGZus{}a}\PYG{p}{,}
        \PYG{n}{objective\PYGZus{}lyapunov}  \PYG{c+c1}{\PYGZsh{} Esta función requiere el runner y opt\PYGZus{}vars}
    \PYG{p}{]}

    \PYG{c+c1}{\PYGZsh{} Usar la lista global de restricciones}
    \PYG{n}{constraints} \PYG{o}{=} \PYG{n}{GLOBAL\PYGZus{}CONSTRAINTS}

    \PYG{c+c1}{\PYGZsh{} Definir el problema de optimización.}
    \PYG{n}{problem} \PYG{o}{=} \PYG{n}{ModularOptimizationProblem}\PYG{p}{(}
        \PYG{n}{sim\PYGZus{}runner}\PYG{p}{,}
        \PYG{n}{n\PYGZus{}free\PYGZus{}bodies}\PYG{o}{=}\PYG{l+m+mi}{3}\PYG{p}{,}  \PYG{c+c1}{\PYGZsh{} 3 cuerpos no centrales en GLOBAL\PYGZus{}BODIES\PYGZus{}CONFIG}
        \PYG{n}{objective\PYGZus{}funcs}\PYG{o}{=}\PYG{n}{objectives}\PYG{p}{,}
        \PYG{n}{constraint\PYGZus{}funcs}\PYG{o}{=}\PYG{n}{constraints}
    \PYG{p}{)}

    \PYG{c+c1}{\PYGZsh{} Seleccionar NSGA\PYGZhy{}II como algoritmo multiobjetivo}
    \PYG{n}{algorithm} \PYG{o}{=} \PYG{n}{NSGA2}\PYG{p}{(}\PYG{n}{pop\PYGZus{}size}\PYG{o}{=}\PYG{l+m+mi}{50}\PYG{p}{)}

    \PYG{c+c1}{\PYGZsh{} Ejecutar la optimización (ajustar el criterio de terminación según sea necesario)}
    \PYG{n}{res} \PYG{o}{=} \PYG{n}{minimize}\PYG{p}{(}\PYG{n}{problem}\PYG{p}{,} \PYG{n}{algorithm}\PYG{p}{,} \PYG{n}{termination}\PYG{o}{=}\PYG{p}{(}\PYG{l+s+s1}{\PYGZsq{}n\PYGZus{}gen\PYGZsq{}}\PYG{p}{,} \PYG{l+m+mi}{100}\PYG{p}{),} \PYG{n}{seed}\PYG{o}{=}\PYG{l+m+mi}{1}\PYG{p}{,} \PYG{n}{verbose}\PYG{o}{=}\PYG{k+kc}{True}\PYG{p}{)}

    \PYG{c+c1}{\PYGZsh{} Mostrar resultados}
    \PYG{n+nb}{print}\PYG{p}{(}\PYG{l+s+s2}{\PYGZdq{}Soluciones no dominadas (condiciones iniciales):\PYGZdq{}}\PYG{p}{)}
    \PYG{n+nb}{print}\PYG{p}{(}\PYG{n}{res}\PYG{o}{.}\PYG{n}{X}\PYG{p}{)}
    \PYG{n+nb}{print}\PYG{p}{(}\PYG{l+s+s2}{\PYGZdq{}}\PYG{l+s+se}{\PYGZbs{}n}\PYG{l+s+s2}{Valores de los objetivos (variación en a y lambda):\PYGZdq{}}\PYG{p}{)}
    \PYG{n+nb}{print}\PYG{p}{(}\PYG{n}{res}\PYG{o}{.}\PYG{n}{F}\PYG{p}{)}
    \PYG{n+nb}{print}\PYG{p}{(}\PYG{l+s+s2}{\PYGZdq{}}\PYG{l+s+se}{\PYGZbs{}n}\PYG{l+s+s2}{Restricciones (deben ser \PYGZlt{}= 0):\PYGZdq{}}\PYG{p}{)}
    \PYG{n+nb}{print}\PYG{p}{(}\PYG{n}{res}\PYG{o}{.}\PYG{n}{G}\PYG{p}{)}
\end{Verbatim}
